<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="view.MessageController"
            style="-fx-background-color: black;">
    <left>
        <VBox prefWidth="220"
              spacing="10"
              style="-fx-background-color: #1e1e1e;">
            <padding>
                <Insets top="15" right="10" bottom="15" left="10"/>
            </padding>

            <Label text="Online Users"
                   textFill="#8272f7"
                   style="-fx-font-size:16; -fx-font-weight:bold;"/>

            <ListView fx:id="usersListView"
                      VBox.vgrow="ALWAYS"/>

            <Button fx:id="refreshButton"
                    text="Refresh"
                    onAction="#refreshUsers"
                    style="-fx-background-color:#8272f7;"
                    textFill="WHITE"/>

        </VBox>

    </left>

    <!-- ================= Center ================= -->

    <center>

        <VBox spacing="10"
              style="-fx-background-color:black;">

            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <HBox alignment="CENTER_LEFT"
                  spacing="15">

                <Button fx:id="backButton"
                        text="← Back"
                        onAction="#goBack"
                        style="-fx-background-color:#444444;"
                        textFill="WHITE"/>

                <Label fx:id="chatTitleLabel"
                       text="Select a user"
                       textFill="#8272f7"
                       style="-fx-font-size:17; -fx-font-weight:bold;"/>

                <Label fx:id="connectionLabel"
                       text="Offline"
                       textFill="RED"/>

            </HBox>

            <ListView fx:id="messagesListView"
                      VBox.vgrow="ALWAYS"/>

            <HBox spacing="10">

                <TextField fx:id="messageField"
                           promptText="Type a message..."
                           HBox.hgrow="ALWAYS"/>

                <Button fx:id="sendButton"
                        text="Send"
                        onAction="#sendMessage"
                        style="-fx-background-color:#8272f7;"
                        textFill="WHITE"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>