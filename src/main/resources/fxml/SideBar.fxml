<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="200.0" style="-fx-background-color: black;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.SideBarController">
   <children>
      <Button fx:id="homeBtn" layoutX="60.0" layoutY="40.0" mnemonicParsing="false" onAction="#goToHome" prefHeight="26.0" prefWidth="80.0" style="-fx-background-color: #8272f7;" text="Home" textFill="WHITE" />
      <Button fx:id="searchBtn" layoutX="60.0" layoutY="95.0" mnemonicParsing="false" onAction="#goToSearch" prefHeight="26.0" prefWidth="80.0" style="-fx-background-color: #8272f7;" text="Search" textFill="WHITE" />
      <Button fx:id="profileBtn" layoutX="60.0" layoutY="150.0" mnemonicParsing="false" onAction="#goToProfile" prefHeight="26.0" prefWidth="80.0" style="-fx-background-color: #8272f7;" text="Profile" textFill="WHITE" />
      <Button fx:id="newBtn" layoutX="60.0" layoutY="205.0" mnemonicParsing="false" onAction="#goToNew" prefHeight="26.0" prefWidth="80.0" style="-fx-background-color: #8272f7;" text="New" textFill="WHITE" />
      <Button fx:id="messagesBtn" layoutX="60.0" layoutY="260.0" mnemonicParsing="false" onAction="#goToMessages" prefHeight="26.0" prefWidth="80.0" style="-fx-background-color: #8272f7;" text="Messages" textFill="WHITE" />
      <Button fx:id="logoutBtn" layoutX="60.0" layoutY="315.0" mnemonicParsing="false" onAction="#logout" prefHeight="26.0" prefWidth="80.0" style="-fx-background-color: #8272f7;" text="Logout" textFill="WHITE" />
   </children>
</AnchorPane>