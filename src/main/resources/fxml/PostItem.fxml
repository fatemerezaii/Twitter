<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<HBox alignment="TOP_LEFT" prefHeight="93.0" prefWidth="290.0" spacing="10" style="-fx-background-color: #ffffff; -fx-border-color: #e0e0e0; -fx-border-radius: 10; -fx-padding: 10;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.PostItemController">

    <ImageView fx:id="profileImageView" fitHeight="40" fitWidth="40">
        <clip>
            <Circle radius="20" />
        </clip>
    </ImageView>

    <VBox prefHeight="81.0" prefWidth="228.0" spacing="5" HBox.hgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="5">
            <Label fx:id="fullNameLabel" style="-fx-font-weight: bold;" />
            <Circle fx:id="badgeCircle" fill="transparent" radius="6" stroke="#c084fc" strokeWidth="1" />
            <Label fx:id="usernameLabel" style="-fx-text-fill: gray;" />
            <Label fx:id="dateLabel" style="-fx-text-fill: gray; -fx-font-size: 10;" />
        </HBox>
        <Label fx:id="repliedLabel" style="-fx-text-fill: gray; -fx-font-size: 10;" />
        <Label fx:id="postTextLabel" wrapText="true" />
        <ImageView fx:id="mediaThumbnail" fitHeight="41.0" fitWidth="50.0" preserveRatio="true">
            <VBox.margin>
                <Insets left="80.0" />
            </VBox.margin></ImageView>
        <HBox alignment="CENTER_LEFT" prefHeight="26.0" prefWidth="258.0" spacing="15.0">
            <Button fx:id="likeButton" onAction="#onLikeClick" prefHeight="26.0" prefWidth="79.0" style="-fx-background-color: #8272f7;" text="❤ Like" />
            <Button fx:id="replyButton1" onAction="#onReplyClick" style="-fx-background-color: #8272f7;" text="View " />
            <Button fx:id="replyButton" onAction="#onReplyClick" style="-fx-background-color: #8272f7;" text="💬 Reply">
                <HBox.margin>
                    <Insets />
                </HBox.margin></Button>
        </HBox>
    </VBox>
</HBox>