   <children>
      <VBox layoutX="208.0" layoutY="38.0" prefHeight="170.0" prefWidth="122.0">
         <children>
            <Button fx:id="hashtag1" mnemonicParsing="false" onAction="#clickHashtag" text="#Literature">
