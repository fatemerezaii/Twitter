         </children>
      </VBox>
      <Button fx:id="confirmButton" layoutX="291.0" layoutY="252.0" mnemonicParsing="false" onAction="#confirm" prefHeight="26.0" prefWidth="226.0" style="-fx-background-color: #8272f7;" text="Confirm" textFill="WHITE" />
