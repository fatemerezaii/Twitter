<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="750.0" style="-fx-background-color: black;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.AdminDashboardController">

   <children>
      <VBox layoutX="263.0" prefHeight="400.0" prefWidth="322.0">
         <children>
            <Button fx:id="popularPosts" mnemonicParsing="false" onAction="#popularPosts" prefHeight="46.0" prefWidth="128.0" style="-fx-background-color: #8272f7;" text="Popular Posts" textFill="WHITE">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
               <VBox.margin>
                  <Insets left="97.0" top="35.0" />
               </VBox.margin>
            </Button>

            <Button fx:id="popularHashtags" mnemonicParsing="false" onAction="#popularHashtags" prefHeight="46.0" prefWidth="128.0" style="-fx-background-color: #8272f7;" text="Popular Hashtags" textFill="WHITE">
               <VBox.margin>
                  <Insets left="98.0" top="30.0" />
               </VBox.margin>
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </Button>

            <Button fx:id="postsList" mnemonicParsing="false" onAction="#postsList" prefHeight="47.0" prefWidth="126.0" style="-fx-background-color: #8272f7;" text="Posts List" textFill="WHITE">
               <VBox.margin>
                  <Insets left="100.0" top="30.0" />
               </VBox.margin>
            </Button>

            <Button fx:id="usersList" mnemonicParsing="false" onAction="#usersList" prefHeight="44.0" prefWidth="122.0" style="-fx-background-color: #8272f7;" text="Users List" textFill="WHITE">
               <VBox.margin>
                  <Insets left="101.0" top="30.0" />
               </VBox.margin>
            </Button>

            <Button fx:id="manageReportBtn" mnemonicParsing="false" onAction="#manageReports" prefHeight="45.0" prefWidth="126.0" style="-fx-background-color: #8272f7;" text="Manage Reports" textFill="WHITE">
               <VBox.margin>
                  <Insets left="100.0" top="30.0" />
               </VBox.margin>
            </Button>
         </children>
      </VBox>
      <Button fx:id="logoutBtn" layoutX="90.0" layoutY="44.0" mnemonicParsing="false" onAction="#logout" style="-fx-background-color: red;" text="Logout" textFill="WHITE" />
   </children>
</AnchorPane>