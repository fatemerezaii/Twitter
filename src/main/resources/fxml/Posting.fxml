<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: black;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.PostingController">
   <children>
      <AnchorPane fx:id="aPane" layoutY="1.0" prefHeight="600.0" prefWidth="200.0" style="-fx-background-color: black;" />

      <VBox layoutX="220.0" layoutY="30.0" prefWidth="550.0" spacing="15" style="-fx-background-color: black;">
         <children>
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Create New Post" textFill="#8272f7" />

            <TextArea fx:id="textArea" prefHeight="150.0" promptText="What's happening?" wrapText="true" />

            <HBox alignment="CENTER_LEFT" spacing="20">
               <children>
                  <Button fx:id="importMediaBtn" onAction="#importMedia" style="-fx-background-color: #8272f7;" text="Import Media" />
                  <Label fx:id="mediaNameLabel" style="-fx-text-fill: gray;" text="No media selected" textFill="WHITE" />
               </children>
            </HBox>

            <Button fx:id="postBtn" onAction="#post" prefWidth="100.0" style="-fx-background-color: #8272f7;" text="Post" />
         </children>
      </VBox>
   </children>
</AnchorPane>
