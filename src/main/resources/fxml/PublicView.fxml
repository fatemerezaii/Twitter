<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.shape.Circle?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: black;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.PublicViewController">
    <children>
        <AnchorPane fx:id="aPane" layoutX="2.0" prefHeight="600.0" prefWidth="200.0" style="-fx-background-color: black;" />
        <ScrollPane layoutX="220.0" layoutY="20.0" prefHeight="560.0" prefWidth="560.0">
            <content>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="700.0" prefWidth="540.0">
                    <children>
                        <HBox alignment="CENTER_LEFT" layoutX="20" layoutY="15" spacing="10">
                            <Label fx:id="fullName" style="-fx-font-size: 20; -fx-font-weight: bold;" />
                            <Circle fx:id="blueCircle" fill="DODGERBLUE" radius="8" visible="false" />
                            <Circle fx:id="goldCircle" fill="GOLD" radius="8" visible="false" />
                        </HBox>
                        <Label fx:id="user" layoutX="20" layoutY="55" style="-fx-text-fill: gray;" />
                        <Label fx:id="bio" layoutX="20" layoutY="80" prefWidth="500" wrapText="true" />
                        <Label fx:id="date" layoutX="20" layoutY="120" style="-fx-text-fill: gray;" text="Member since" />
                        <Label fx:id="year" layoutX="110" layoutY="120" />

                        <HBox layoutX="20" layoutY="150" spacing="20">
                            <Label fx:id="followersCount" style="-fx-font-weight: bold;" />
                            <Label fx:id="followers" text="Followers" />
                            <Label fx:id="followingCount" style="-fx-font-weight: bold;" />
                            <Label fx:id="following" text="Following" />
                        </HBox>

                        <Button fx:id="followBtn" layoutX="20" layoutY="200" onAction="#follow" style="-fx-background-color: #8272f7;" text="Follow" textFill="WHITE" />
                        <Button fx:id="reportBtn" layoutX="120" layoutY="200" onAction="#report" style="-fx-background-color: #8272f7;" text="Report" textFill="WHITE" />

                        <TabPane layoutX="0" layoutY="250" prefHeight="450" prefWidth="540" tabClosingPolicy="UNAVAILABLE">
                            <tabs>
                                <Tab text="Posts">
                                    <content>
                                        <AnchorPane>
                                            <children>
                                                <ComboBox fx:id="comboBox" layoutX="14.0" layoutY="10.0" prefWidth="150.0" />
                                                <ListView fx:id="postsListView" layoutX="-1.0" layoutY="40.0" prefHeight="311.0" prefWidth="466.0" />
                                            </children>
                                        </AnchorPane>
                                    </content>
                                </Tab>
                            </tabs>
                        </TabPane>
                    </children>
                </AnchorPane>
            </content>
        </ScrollPane>
    </children>
</AnchorPane>
